{
  "name": "scrapbook-chess-repository",
  "private": true,
  "scripts": {
    "yaml:format": "node scripts/format-yaml.mjs",
    "yaml:check": "node scripts/format-yaml.mjs --check",
    "docs:check": "node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --dir server build && pnpm --dir web build",
    "test": "pnpm --dir server test && pnpm --dir web test",
    "test:browser": "pnpm --dir server build && pnpm --dir web test:browser",
    "book:check": "node scripts/check-opening-book.mjs"
  },
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "yaml": "2.9.0"
  }
}
