{
  "name": "scrapbook-chess-browser-proof",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "dev": "pnpm prepare:engine && vite --host 127.0.0.1",
    "build": "pnpm prepare:engine && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "chessops": "0.15.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stockfish": "19.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
